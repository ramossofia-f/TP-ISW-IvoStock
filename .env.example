# python scripts/configurar.py genera .env con secretos aleatorios.
POSTGRES_PASSWORD=REEMPLAZAR
DATABASE_URL=postgresql+psycopg://ivostock:REEMPLAZAR@postgres:5432/ivostock
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REEMPLAZAR
S3_SECRET_KEY=REEMPLAZAR
S3_BUCKET=snapshots
SIMULATOR_URL=http://simulator:8001
SIMULATOR_TOKEN=REEMPLAZAR
SIMULATOR_ADMIN_TOKEN=REEMPLAZAR
TASK_LEASE_SECONDS=30
CATALOG_FEED=data/feeds/celesa.csv
# Login de demostración Admin/Admin del POC; configurar.py guarda sólo su hash PBKDF2.
DEMO_USERNAME=Admin
DEMO_PASSWORD_HASH=REEMPLAZAR
# Puerto local de PostgreSQL; cambiarlo si 5432 está ocupado.
POSTGRES_HOST_PORT=5432
