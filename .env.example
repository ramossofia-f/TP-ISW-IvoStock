# Copiar a .env (que no se versiona) y ajustar. Los valores de abajo son solo para desarrollo local.

# PostgreSQL del motor
POSTGRES_USER=ivostock
POSTGRES_PASSWORD=ivostock-dev
POSTGRES_DB=motor
DATABASE_URL=postgresql://ivostock:ivostock-dev@localhost:5432/motor

# Almacenamiento de objetos para los snapshots (MinIO en local)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ivostock
S3_SECRET_KEY=ivostock-dev-secret
S3_BUCKET=snapshots

# Feed real de Celesa. La URL lleva las credenciales en la query: nunca se versiona ni se loguea.
CELESA_FEED_URL=https://<host>/<ruta>?usuario=<usuario>&clave=<clave>
