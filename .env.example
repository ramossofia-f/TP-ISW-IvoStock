# python scripts/configurar.py genera .env con secretos aleatorios.
POSTGRES_PASSWORD=REEMPLAZAR
DATABASE_URL=postgresql+psycopg://ivostock:REEMPLAZAR@postgres:5432/ivostock
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REEMPLAZAR
S3_SECRET_KEY=REEMPLAZAR
S3_BUCKET=snapshots
# Región de S3; en AWS, S3_ENDPOINT y las claves quedan vacíos (ver docs/despliegue/AWS.md).
S3_REGION=us-east-1
SIMULATOR_URL=http://simulator:8001
SIMULATOR_TOKEN=REEMPLAZAR
SIMULATOR_ADMIN_TOKEN=REEMPLAZAR
TASK_LEASE_SECONDS=30
CATALOG_FEED=data/feeds/celesa.csv
# Tiendas del marketplace con credenciales preconfiguradas: las que la aplicación puede incorporar.
MARKETPLACE_STORES=T1,T2
# Operadores precreados (RF-01): usuario=hash separados por coma. configurar.py guarda sólo los
# hashes PBKDF2 aquí y las contraseñas en data/operadores.txt (fuera de Git).
OPERATOR_ACCOUNTS=REEMPLAZAR
# Duración de una sesión iniciada, en minutos.
SESSION_TTL_MINUTES=480
# Puerto local de PostgreSQL; cambiarlo si 5432 está ocupado.
POSTGRES_HOST_PORT=5432
# Métricas internas (muestreo fijo de 60 segundos y retención fija de siete días).
METRICS_HOST_PORT=8004
# Observador opcional, sin acceso a PostgreSQL ni persistencia propia.
OBSERVER_HOST_PORT=8003
OBSERVER_METRICS_URL=http://metrics:8002
OBSERVER_API_URL=http://api:8000
OBSERVER_SIMULATOR_URL=http://simulator:8001
OBSERVER_PROVIDER_URL=http://provider:8081
OBSERVER_ML_URL=http://ml:8002

# Servicio de inferencia interno; no usa la sesión del operador.
ML_URL=http://ml:8002
ML_TOKEN=REEMPLAZAR
ML_MIN_RUNS=10
ML_HISTORY_PER_PROVIDER=200
ML_HALF_LIFE_DAYS=7
ML_NU=0.05
ML_RETRY_SECONDS=30
# Puerto de las sondas del observador externo, sólo accesible desde localhost.
ML_HOST_PORT=8002
